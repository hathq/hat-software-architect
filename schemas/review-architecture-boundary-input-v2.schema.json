{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope_ref",
    "revision",
    "semantic",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "hathq://hat-software-architect/review-architecture-boundary-input/v2"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9:/._-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "semantic": {
      "$ref": "#/$defs/semantic"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hathq://hat-software-architect/review-architecture-boundary-input/v2",
  "$defs": {
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_sha256",
        "term_id",
        "definition_revision"
      ],
      "properties": {
        "module_sha256": {
          "const": "6736c2fc5fc6819f2baa9b403362b1b6873600f0abb96ae37ae2b10f723116da"
        },
        "term_id": {
          "const": "737c04107b2d09fe17a865a3c9b4718f"
        },
        "definition_revision": {
          "type": "string",
          "pattern": "^definitions-[0-9a-f]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_ref",
        "reference",
        "digest_sha256",
        "subject_ref",
        "stage",
        "revision",
        "outcome"
      ],
      "properties": {
        "scope_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9:/._-]+$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9:/._-]+$"
        },
        "digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9:/._-]+$"
        },
        "stage": {
          "type": "string",
          "enum": [
            "implementation",
            "test",
            "publication",
            "deployment"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740990
        },
        "outcome": {
          "type": "string",
          "enum": [
            "verified",
            "failed",
            "unknown"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ref",
        "stage",
        "evidence"
      ],
      "properties": {
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9:/._-]+$"
        },
        "stage": {
          "type": "string",
          "enum": [
            "implementation",
            "test",
            "publication",
            "deployment"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  }
}
